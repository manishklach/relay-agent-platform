# Optional. Relay is fully runnable with its deterministic local provider when unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Set this to production in hosted environments. Production rejects insecure
# provider URLs and never silently downgrades a real provider to the mock.
RELAY_ENV=development

# Provider network bounds and transient retry policy.
RELAY_MODEL_TIMEOUT_MS=30000
RELAY_MODEL_MAX_RESPONSE_BYTES=1048576
RELAY_MODEL_MAX_ATTEMPTS=3

# Per-run safety budgets.
RELAY_RUN_MAX_TURNS=4
RELAY_RUN_MAX_TOOL_CALLS=12
RELAY_RUN_MAX_INPUT_TOKENS=100000
RELAY_RUN_MAX_OUTPUT_TOKENS=16000
RELAY_RUN_MAX_COST_USD=1
RELAY_RUN_MAX_DURATION_MS=120000
